{
  "name": "markdowndesk",
  "private": true,
  "version": "0.1.0",
  "description": "Build-time dependencies for the offline macOS Markdown editor",
  "scripts": {
    "prepare-vendor": "node scripts/prepare-vendor.js",
    "build": "node scripts/build.js",
    "build:mac": "./scripts/build.sh",
    "build:linux": "npx tauri build",
    "appimage": "npx tauri build --bundles appimage",
    "dmg": "./scripts/package-dmg.sh local",
    "pretest": "node scripts/prepare-vendor.js",
    "test": "node scripts/prepare-vendor.js && node --test"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "mermaid": "^12.2.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "jsdom": "27.4.0"
  }
}
